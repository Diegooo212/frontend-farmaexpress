# Copia este archivo como .env y completa los valores (el .env no se sube a GitHub).
# Microsoft Entra ID usa DOS App Registrations: ver docs/ENTRA-ID.md, sección 2.

# Tenant (Overview del tenant → Tenant ID). Es el mismo para las dos apps.
VITE_AZURE_TENANT_ID=PEGAR_TENANT_ID

# App del FRONTEND (SPA) "FarmaExpress Web": con ella la persona inicia sesión.
VITE_AZURE_CLIENT_ID=PEGAR_CLIENT_ID_DE_LA_APP_DEL_FRONTEND

# App de la API "FarmaExpress API": App Roles + scope access_as_user. El backend valida este ID (aud).
VITE_AZURE_API_CLIENT_ID=PEGAR_CLIENT_ID_DE_LA_APP_DE_LA_API

# A dónde vuelve el navegador después del login (en producción se deja vacío: usa el dominio actual).
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Backend: local (http://localhost:8080) o el API Gateway en la nube.
VITE_API_BASE_URL=http://localhost:8080
